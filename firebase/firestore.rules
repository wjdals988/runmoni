rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid is string
        && request.auth.uid.size() > 0
        && request.auth.uid.size() <= 128
        && request.auth.uid == uid;
    }

    function isRunSummary(data, runId) {
      let fields = [
        'schemaVersion', 'runId', 'startedAtMillis', 'finishedAtMillis',
        'activeDurationMillis', 'distanceMeters', 'pointCount', 'backupAt'
      ];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.runId is string
        && data.runId.matches('^[A-Za-z0-9_-]{1,128}$')
        && data.runId == runId
        && data.startedAtMillis is int
        && data.startedAtMillis >= 0
        && data.startedAtMillis <= 253402300799999
        && data.finishedAtMillis is int
        && data.finishedAtMillis > 0
        && data.finishedAtMillis >= data.startedAtMillis
        && data.finishedAtMillis <= 253402300799999
        && data.activeDurationMillis is int
        && data.activeDurationMillis >= 0
        && data.activeDurationMillis <= data.finishedAtMillis - data.startedAtMillis
        && data.distanceMeters is number
        // Both comparisons reject NaN and +/-Infinity without trusting client checks.
        && data.distanceMeters >= 0
        && data.distanceMeters <= 10000000
        && data.pointCount is int
        && data.pointCount >= 0
        && data.pointCount <= 1000000
        && data.backupAt is timestamp
        && data.backupAt == request.time;
    }

    match /users/{uid}/runSummaries/{runId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) && isRunSummary(request.resource.data, runId);
      allow delete: if isOwner(uid);
    }

    // Spark community is separate from personal summaries and the trusted pilot wallet.
    function signedIn() { return request.auth != null; }
    function validRoomId(id) { return id is string && id.matches('^[A-Za-z0-9]{20}$'); }
    function profilePath(uid) { return /databases/$(database)/documents/communityProfiles/$(uid); }
    function nicknamePath(key) { return /databases/$(database)/documents/communityNicknames/$(key); }
    function roomPath(id) { return /databases/$(database)/documents/communityRooms/$(id); }
    function memberPath(id, uid) { return /databases/$(database)/documents/communityRooms/$(id)/members/$(uid); }
    function messagePath(id, mid) { return /databases/$(database)/documents/communityRooms/$(id)/messages/$(mid); }
    function memberOf(id) { return signedIn() && exists(memberPath(id, request.auth.uid)); }
    // A party never grants access independently of its parent crew membership.
    function readableMember(id) {
      let r = get(roomPath(id)).data;
      return memberOf(id) && r.status != 'deleted'
        && (r.kind == 'crew' || parentMembership(r));
    }
    function manager(id) {
      let r = get(roomPath(id)).data;
      return signedIn() && (r.ownerUid == request.auth.uid ||
        (r.kind == 'party' && r.crewId != '' && get(roomPath(r.crewId)).data.ownerUid == request.auth.uid));
    }
    function boundedList(maximum) {
      return request.query.limit != null && request.query.limit > 0 && request.query.limit <= maximum;
    }
    function validNickname(name) { return name is string && name.matches('^[A-Za-z0-9_가-힣 -]{2,24}$'); }
    function validNewNickname(name) {
      return name is string && name.size() >= 2 && name.size() <= 16
        && name.matches('^[A-Za-z0-9_가-힣-]+( [A-Za-z0-9_가-힣-]+)*$')
        && name.matches('.*[A-Za-z0-9가-힣].*');
    }
    function validProfile(d) {
      return d.keys().hasAll(['nickname', 'createdAt', 'updatedAt', 'joinedRoomIds', 'lastRoomId', 'createdRoomCount', 'lastRoomCreatedAt'])
        && d.keys().hasOnly(['nickname', 'nicknameKey', 'createdAt', 'updatedAt', 'joinedRoomIds', 'lastRoomId', 'createdRoomCount', 'lastRoomCreatedAt'])
        && validNickname(d.nickname) && d.createdAt is timestamp && d.updatedAt == request.time
        && (!('nicknameKey' in d) || (validNewNickname(d.nickname) && d.nicknameKey is string && d.nicknameKey == d.nickname.lower()))
        && d.joinedRoomIds is list && d.joinedRoomIds.size() <= 100
        && d.joinedRoomIds.toSet().size() == d.joinedRoomIds.size()
        && d.lastRoomId is string && d.createdRoomCount is int && d.createdRoomCount >= 0 && d.createdRoomCount <= 1000000
        && d.lastRoomCreatedAt is timestamp;
    }
    function claimedNicknameAfter(d, uid) {
      return 'nicknameKey' in d && validNewNickname(d.nickname) && d.nicknameKey == d.nickname.lower()
        && getAfter(nicknamePath(d.nicknameKey)).data.uid == uid
        && getAfter(nicknamePath(d.nicknameKey)).data.nickname == d.nickname
        && getAfter(nicknamePath(d.nicknameKey)).data.updatedAt == request.time;
    }
    function previousNicknameReleased(uid) {
      let key = resource.data.get('nicknameKey', '');
      return key == '' || key == request.resource.data.nicknameKey
        || !exists(nicknamePath(key)) || get(nicknamePath(key)).data.uid != uid
        || !existsAfter(nicknamePath(key));
    }
    function profileNicknameUpdate(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'nicknameKey', 'updatedAt'])
        && claimedNicknameAfter(request.resource.data, uid) && previousNicknameReleased(uid);
    }
    function profileMembershipUpdate(uid) {
      let old = resource.data;
      let d = request.resource.data;
      let id = d.lastRoomId;
      let beforeIds = old.joinedRoomIds.toSet();
      let afterIds = d.joinedRoomIds.toSet();
      let creating = !exists(roomPath(id));
      return validRoomId(id)
        && d.diff(old).affectedKeys().hasOnly(['joinedRoomIds', 'lastRoomId', 'updatedAt', 'createdRoomCount', 'lastRoomCreatedAt'])
        && ((!(id in beforeIds) && afterIds == beforeIds.union([id].toSet())
              && existsAfter(memberPath(id, uid))
              && (creating ? (d.createdRoomCount == old.createdRoomCount + 1
                  && d.lastRoomCreatedAt == request.time
                  && request.time >= old.lastRoomCreatedAt + duration.value(10, 's'))
                : (d.createdRoomCount == old.createdRoomCount && d.lastRoomCreatedAt == old.lastRoomCreatedAt)))
            || (id in beforeIds && afterIds == beforeIds.difference([id].toSet())
              && !existsAfter(memberPath(id, uid))
              && d.createdRoomCount == old.createdRoomCount && d.lastRoomCreatedAt == old.lastRoomCreatedAt));
    }
    match /communityProfiles/{uid} {
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create: if isOwner(uid) && validProfile(request.resource.data)
        && claimedNicknameAfter(request.resource.data, uid)
        && request.resource.data.createdAt == request.time && request.resource.data.joinedRoomIds.size() == 0
        && request.resource.data.lastRoomId == '' && request.resource.data.createdRoomCount == 0
        && request.resource.data.lastRoomCreatedAt == timestamp.value(0);
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        // Legacy names stay readable and usable; new names cannot bypass a reservation.
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          || profileNicknameUpdate(uid) || profileMembershipUpdate(uid));
    }
    match /communityNicknames/{key} {
      function validClaim(d) {
        return d.keys().hasAll(['uid', 'nickname', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['uid', 'nickname', 'createdAt', 'updatedAt'])
          && isOwner(d.uid) && validNewNickname(d.nickname) && key == d.nickname.lower()
          && d.createdAt is timestamp && d.updatedAt == request.time
          && getAfter(profilePath(d.uid)).data.nicknameKey == key
          && getAfter(profilePath(d.uid)).data.nickname == d.nickname;
      }
      // Availability is an authenticated, exact-key read; profiles and directory lists remain private.
      allow get: if signedIn();
      allow list: if false;
      allow create: if validClaim(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isOwner(resource.data.uid) && validClaim(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(resource.data.uid)
        && existsAfter(profilePath(resource.data.uid))
        && getAfter(profilePath(resource.data.uid)).data.get('nicknameKey', '') != key;
    }
    function linkedAfter(id) { return id in getAfter(profilePath(request.auth.uid)).data.joinedRoomIds; }
    function validRoom(d) {
      return d.keys().hasAll(['kind', 'visibility', 'ownerUid', 'title', 'description', 'region', 'paceLabel', 'capacity', 'memberCount',
          'createdAt', 'updatedAt', 'crewId', 'partyKind', 'startsAtMillis', 'meetingLabel', 'distanceKm', 'status'])
        && d.keys().hasOnly(['kind', 'visibility', 'ownerUid', 'title', 'description', 'region', 'paceLabel', 'capacity', 'memberCount',
          'createdAt', 'updatedAt', 'crewId', 'partyKind', 'startsAtMillis', 'meetingLabel', 'distanceKm', 'status'])
        && d.kind in ['crew', 'party'] && d.visibility == 'open' && d.ownerUid is string
        && d.title is string && d.title.size() >= 2 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 500 && d.region is string && d.region.size() <= 80
        && d.paceLabel is string && d.paceLabel.size() <= 80
        && d.memberCount is int && d.memberCount >= (d.status == 'deleted' ? 0 : 1) && d.capacity is int && d.memberCount <= d.capacity
        && d.createdAt is timestamp && d.updatedAt == request.time && d.status in ['active', 'cancelled', 'deleted']
        && d.crewId is string && d.meetingLabel is string && d.meetingLabel.size() <= 200
        && d.startsAtMillis is int && d.distanceKm is number
        && ((d.kind == 'crew' && d.capacity == 100 && d.crewId == '' && d.partyKind == '' && d.startsAtMillis == 0 && d.distanceKm == 0)
          || (d.kind == 'party' && d.capacity >= 2 && d.capacity <= 20 && d.partyKind in ['local', 'remote']
            && d.startsAtMillis > 0 && d.paceLabel.size() >= 1 && d.distanceKm > 0 && d.distanceKm <= 100
            && (d.partyKind != 'local' || d.meetingLabel.size() > 0)));
    }
    function parentMembership(d) {
      return d.kind == 'crew' || (validRoomId(d.crewId)
        && get(roomPath(d.crewId)).data.kind == 'crew'
        && get(roomPath(d.crewId)).data.status == 'active' && memberOf(d.crewId));
    }
    function membershipCountUpdate(id) {
      let d = request.resource.data;
      let uid = request.auth.uid;
      return d.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
        && ((d.memberCount == resource.data.memberCount + 1 && resource.data.status == 'active'
            && (resource.data.kind != 'party' || resource.data.startsAtMillis > request.time.toMillis())
            && !exists(memberPath(id, uid)) && existsAfter(memberPath(id, uid)) && linkedAfter(id) && parentMembership(resource.data))
          || (d.memberCount == resource.data.memberCount - 1
            && (resource.data.ownerUid != uid || resource.data.status == 'deleted')
            && exists(memberPath(id, uid)) && !existsAfter(memberPath(id, uid)) && !linkedAfter(id)));
    }
    match /communityRooms/{id} {
      allow get: if resource.data.visibility == 'open';
      allow list: if boundedList(50) && resource.data.visibility == 'open';
      allow create: if signedIn() && validRoomId(id) && validRoom(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time && request.resource.data.status == 'active'
        && (request.resource.data.kind != 'party' || request.resource.data.startsAtMillis > request.time.toMillis())
        && parentMembership(request.resource.data)
        && getAfter(memberPath(id, request.auth.uid)).data.role == 'owner' && linkedAfter(id)
        && getAfter(profilePath(request.auth.uid)).data.lastRoomCreatedAt == request.time;
      allow update: if signedIn() && validRoom(request.resource.data)
        && (membershipCountUpdate(id) || (manager(id) && resource.data.kind == 'party'
          && ((resource.data.status == 'active' && request.resource.data.status == 'cancelled')
            || (resource.data.status in ['active', 'cancelled'] && request.resource.data.status == 'deleted'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])));
      allow delete: if false;

      function validMember(d, uid) {
        return d.keys().hasAll(['uid', 'nickname', 'role', 'joinedAt', 'lastMessageAt', 'lastMessageId'])
          && d.keys().hasOnly(['uid', 'nickname', 'role', 'joinedAt', 'lastMessageAt', 'lastMessageId'])
          && d.uid == uid && validNickname(d.nickname) && d.role in ['owner', 'dj', 'member']
          && d.joinedAt is timestamp && d.lastMessageAt is timestamp && d.lastMessageId is string;
      }
      match /members/{uid} {
        allow get: if isOwner(uid) || readableMember(id);
        allow list: if boundedList(100) && readableMember(id);
        allow create: if isOwner(uid) && validMember(request.resource.data, uid)
          && request.resource.data.nickname == get(profilePath(uid)).data.nickname
          && request.resource.data.joinedAt == request.time && request.resource.data.lastMessageAt == timestamp.value(0)
          && request.resource.data.lastMessageId == '' && linkedAfter(id)
          && getAfter(roomPath(id)).data.memberCount == (exists(roomPath(id)) ? get(roomPath(id)).data.memberCount + 1 : 1)
          && (getAfter(roomPath(id)).data.ownerUid == uid ? request.resource.data.role == 'owner' : request.resource.data.role == 'member');
        allow delete: if isOwner(uid)
          && (get(roomPath(id)).data.ownerUid != uid || get(roomPath(id)).data.status == 'deleted')
          && getAfter(roomPath(id)).data.memberCount == get(roomPath(id)).data.memberCount - 1 && !linkedAfter(id);
        allow update: if signedIn() && get(roomPath(id)).data.status != 'deleted' && validMember(request.resource.data, uid)
          && ((manager(id) && parentMembership(get(roomPath(id)).data)
              && resource.data.role != 'owner' && request.resource.data.role in ['member', 'dj']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
            || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'lastMessageAt', 'lastMessageId'])
              && request.resource.data.nickname == get(profilePath(uid)).data.nickname
              && request.resource.data.lastMessageAt == request.time && validRoomId(request.resource.data.lastMessageId)
              && !exists(messagePath(id, request.resource.data.lastMessageId))
              && getAfter(messagePath(id, request.resource.data.lastMessageId)).data.authorUid == uid
              && getAfter(messagePath(id, request.resource.data.lastMessageId)).data.createdAt == request.time));
      }
      match /messages/{mid} {
        allow get: if readableMember(id);
        allow list: if boundedList(50) && readableMember(id);
        allow create: if readableMember(id) && validRoomId(mid) && get(roomPath(id)).data.status == 'active'
          && request.resource.data.keys().hasAll(['authorUid', 'nickname', 'body', 'kind', 'createdAt'])
          && request.resource.data.keys().hasOnly(['authorUid', 'nickname', 'body', 'kind', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.nickname == getAfter(memberPath(id, request.auth.uid)).data.nickname
          && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 1000
          && request.resource.data.kind in ['chat', 'announcement'] && request.resource.data.createdAt == request.time
          && (request.resource.data.kind != 'announcement' || get(memberPath(id, request.auth.uid)).data.role in ['owner', 'dj'] || manager(id))
          && request.time >= get(memberPath(id, request.auth.uid)).data.lastMessageAt + duration.value(2, 's')
          && getAfter(memberPath(id, request.auth.uid)).data.lastMessageAt == request.time
          && getAfter(memberPath(id, request.auth.uid)).data.lastMessageId == mid;
        allow update, delete: if false;
      }
    }

    // Public discovery stores approximate cells only. Consent authority is private.
    function runnerConsentPath(uid) { return /databases/$(database)/documents/runnerConsents/$(uid); }
    function validRunnerToken(token) { return token is string && token.matches('^[A-Za-z0-9_-]{16,64}$'); }
    function validRunnerConsent(d) {
      return d.keys().hasAll(['runSessionToken', 'enabled', 'updatedAt'])
        && d.keys().hasOnly(['runSessionToken', 'enabled', 'updatedAt'])
        && validRunnerToken(d.runSessionToken) && d.enabled is bool && d.updatedAt == request.time;
    }
    function runnerAvatar(d) {
      let fields = ['hair', 'headwear', 'face', 'top', 'bottom', 'costume', 'socks', 'shoes', 'ear', 'eyewear', 'wrist', 'waist', 'hydration', 'gender', 'colors'];
      return d is map && d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.gender in ['male', 'female']
        && d.hair is int && d.hair >= 0 && d.hair <= 3
        && d.headwear is int && d.headwear >= 0 && d.headwear <= 3
        && d.face is int && d.face >= 0 && d.face <= 3
        && d.top is int && d.top >= 0 && d.top <= 5
        && d.bottom is int && d.bottom >= 0 && d.bottom <= 5
        && d.costume is int && d.costume >= 0 && d.costume <= 5
        && d.socks is int && d.socks >= 0 && d.socks <= 3
        && d.shoes is int && d.shoes >= 0 && d.shoes <= 3
        && d.ear is int && d.ear >= 0 && d.ear <= 3
        && d.eyewear is int && d.eyewear >= 0 && d.eyewear <= 3
        && d.wrist is int && d.wrist >= 0 && d.wrist <= 3
        && d.waist is int && d.waist >= 0 && d.waist <= 3
        && d.hydration is int && d.hydration >= 0 && d.hydration <= 3
        && d.colors is map && d.colors.keys().hasAll(['top', 'bottom', 'shoes'])
        && d.colors.keys().hasOnly(['top', 'bottom', 'shoes'])
        && d.colors.top is int && d.colors.top >= 0 && d.colors.top <= 5
        && d.colors.bottom is int && d.colors.bottom >= 0 && d.colors.bottom <= 5
        && d.colors.shoes is int && d.colors.shoes >= 0 && d.colors.shoes <= 5;
    }
    function validRunnerPresence(uid, d) {
      let fields = ['runSessionToken', 'latitudeE3', 'longitudeE3', 'latBand', 'lonBand', 'nickname', 'avatar', 'visibility', 'adultConfirmed', 'updatedAt', 'expiresAt'];
      let consent = getAfter(runnerConsentPath(uid)).data;
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.latitudeE3 is int && d.latitudeE3 >= -85000 && d.latitudeE3 <= 85000
        && d.longitudeE3 is int && d.longitudeE3 >= -180000 && d.longitudeE3 <= 179999
        && d.latBand is int && d.latBand == math.floor(d.latitudeE3 / 1000.0)
        && d.lonBand is int && d.lonBand == math.floor(d.longitudeE3 / 1000.0)
        && d.visibility == 'approximate' && d.adultConfirmed == true
        && validRunnerToken(d.runSessionToken)
        && consent.enabled == true && consent.runSessionToken == d.runSessionToken
        && validNickname(d.nickname) && d.nickname == get(profilePath(uid)).data.nickname
        && runnerAvatar(d.avatar) && d.updatedAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt >= request.time + duration.value(45, 's')
        && d.expiresAt <= request.time + duration.value(75, 's');
    }
    match /runnerConsents/{uid} {
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create: if isOwner(uid) && validRunnerConsent(request.resource.data)
        && (!request.resource.data.enabled || exists(profilePath(uid)));
      allow update: if isOwner(uid) && validRunnerConsent(request.resource.data)
        && (request.resource.data.enabled ? exists(profilePath(uid))
          : request.resource.data.runSessionToken == resource.data.runSessionToken);
    }
    match /runnerPresence/{uid} {
      allow get: if isOwner(uid) || (signedIn() && exists(profilePath(request.auth.uid)) && resource.data.expiresAt > request.time);
      // The client must use a future expiry lower bound. Reading every marker
      // and filtering expired data locally is deliberately not sufficient.
      allow list: if signedIn() && exists(profilePath(request.auth.uid)) && boundedList(100)
        && resource.data.expiresAt > request.time;
      allow create, update: if isOwner(uid) && exists(profilePath(uid)) && validRunnerPresence(uid, request.resource.data);
      allow delete: if isOwner(uid);
    }

    // Wallets, rewards, original tracks and every other path stay denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
