# Copy to backend/.env and supply operator-controlled values. Never commit .env.
RUNMONI_PILOT_INVITE=
RUNMONI_DB_PATH=backend/data/pilot.sqlite3
RUNMONI_CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
# Configurable abuse backstop: 100 points/km, default up to 100 km/day.
RUNMONI_REWARD_DAILY_LIMIT=10000
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AUDIO_BRIDGE_URL=
# Both bridge secrets must be at least 32 characters and match the bridge settings.
AUDIO_BRIDGE_JWT_SECRET=
AUDIO_BRIDGE_CONTROL_SECRET=
