<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/run_widget_root" android:forceDarkAllowed="false"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp"
    android:background="@drawable/run_widget_surface">
    <TextView android:id="@+id/run_widget_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/run_widget_preview_title" android:textSize="12sp"
        android:textColor="@color/run_widget_primary" android:textStyle="bold"
        android:includeFontPadding="true" android:fallbackLineSpacing="true" android:maxLines="2" />
    <LinearLayout android:id="@+id/run_widget_metrics"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="2dp">
        <TextView android:id="@+id/run_widget_distance"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/run_widget_preview_distance" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/run_widget_text" android:includeFontPadding="true" android:fallbackLineSpacing="true"
            android:fontFeatureSettings="tnum" />
        <TextView android:id="@+id/run_widget_duration"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/run_widget_preview_duration" android:textSize="12sp"
            android:textColor="@color/run_widget_muted" android:includeFontPadding="true" android:fallbackLineSpacing="true"
            android:fontFeatureSettings="tnum" />
        <TextView android:id="@+id/run_widget_speed"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
            android:textSize="12sp" android:textColor="@color/run_widget_muted" />
    </LinearLayout>
    <LinearLayout android:id="@+id/run_widget_actions"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/run_widget_control" style="@style/RunWidgetAction"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/run_widget_pause" />
        <Button android:id="@+id/run_widget_finish" style="@style/RunWidgetAction"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="@string/run_widget_finish" android:contentDescription="@string/run_widget_finish_description"
            android:background="@drawable/run_widget_secondary_action" android:textColor="@color/run_widget_primary" />
    </LinearLayout>
    <Button android:id="@+id/run_widget_open" style="@style/RunWidgetAction"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="@string/run_widget_open" />
    <TextView android:id="@+id/run_widget_footer"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
        android:textSize="12sp" android:textColor="@color/run_widget_muted" />
</LinearLayout>
