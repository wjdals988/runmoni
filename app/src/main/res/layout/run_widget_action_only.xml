<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/run_widget_root" android:forceDarkAllowed="false"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/run_widget_surface">
    <ImageButton android:id="@+id/run_widget_open"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:minWidth="48dp" android:minHeight="48dp"
        android:padding="8dp" android:scaleType="center"
        android:src="@drawable/run_widget_open_icon"
        android:background="@drawable/run_widget_secondary_action"
        android:backgroundTint="@null"
        android:contentDescription="@string/run_widget_open" />
</FrameLayout>
